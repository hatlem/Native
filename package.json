{
  "name": "nativespin",
  "version": "0.0.1",
  "private": true,
  "description": "NativeSpin \u2014 Nordic marketplace for buying native content and native advertising in newspapers and magazines.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts' ! -name '*.it.test.ts')",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "scrape-contacts": "tsx scripts/scrape-publisher-contacts.ts",
    "build-rate-card-campaign": "tsx scripts/build-rate-card-campaign.ts",
    "send-rate-card-batch": "tsx scripts/send-rate-card-batch.ts",
    "build-metrics-campaign": "tsx scripts/build-metrics-campaign.ts",
    "send-metrics-batch": "tsx scripts/send-metrics-batch.ts",
    "send-due-waves": "tsx scripts/send-due-waves.ts",
    "freeze-metrics-campaigns": "tsx scripts/freeze-metrics-campaigns.ts",
    "seed-content-fees": "tsx scripts/seed-content-fees.ts",
    "issue-publisher-key": "tsx scripts/issue-publisher-key.ts",
    "issue-pricing-admin-key": "tsx scripts/issue-pricing-admin-key.ts",
    "seed-playbooks": "tsx scripts/seed-playbooks.ts",
    "test:it": "ALLOW_LOCAL_DB=1 tsx --test \"src/**/*.it.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "esbuild@<0.28.1": ">=0.28.1",
      "js-yaml@<4.3.0": ">=4.3.0 <5",
      "hono@<4.12.27": ">=4.12.27",
      "undici@<7.28.0": ">=7.28.0",
      "brace-expansion@<1.1.16": ">=1.1.16 <2",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7 <6",
      "sharp@<0.35.0": ">=0.35.0",
      "fast-uri@<3.1.4": ">=3.1.4 <4",
      "@hono/node-server@<2.0.5": ">=2.0.5",
      "@auth/core@<0.41.3": ">=0.41.3",
      "body-parser@<2.3.0": ">=2.3.0"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@getplatform/artifact-viewer": "git+https://github.com/hatlem/artifact-viewer.git#v1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "disposable-email-domains": "^1.0.62",
    "free-email-domains": "^1.9.17",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "domhandler": "^6.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "playwright-core": "^1.60.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
