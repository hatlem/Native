{
  "name": "nativespin",
  "version": "0.0.1",
  "private": true,
  "description": "NativeSpin — Nordic marketplace for buying native content and native advertising in newspapers and magazines.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "scrape-contacts": "tsx scripts/scrape-publisher-contacts.ts",
    "build-rate-card-campaign": "tsx scripts/build-rate-card-campaign.ts",
    "send-rate-card-batch": "tsx scripts/send-rate-card-batch.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "disposable-email-domains": "^1.0.62",
    "free-email-domains": "^1.9.17",
    "next": "^15.1.6",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.33.0"
}
