# Copy to .env and adjust. Postgres connection for Prisma.
# Local docker-compose default:
DATABASE_URL="postgresql://atnative:atnative@127.0.0.1:5432/atnative?schema=public"

# App
NEXT_PUBLIC_APP_NAME="ATNative"

# Public site origin — used for absolute canonical/OpenGraph URLs in
# page metadata. Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL="https://atnative.com"

# Google Tag Manager. When set, GTM loads with Consent Mode v2 defaulting
# to denied (a CMP deployed via GTM grants consent). Leave unset to ship
# no third-party tags (e.g. local/dev/CI).
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Optional seed overrides for the desk admin account
# DESK_ADMIN_EMAIL="desk@atnative.com"
# DESK_ADMIN_PASSWORD="atnative-desk"

# --- Auth emails (Resend) ---
# Optional in dev — when unset, emails are logged to the console only.
RESEND_API_KEY=
AUTH_EMAIL_FROM="ATNative <noreply@atnative.com>"
AUTH_EMAIL_REPLY_TO=
AUTH_APP_NAME="ATNative"
