# Postgres connection for Prisma.
# PRODUCTION-ONLY: NativeSpin operates against the production database. Catalog,
# pricing and contact changes go through the prod MCP (native_* tools) — NOT
# local Prisma scripts. src/lib/prisma.ts THROWS if DATABASE_URL points at
# localhost outside production, so a stray `prisma migrate dev` / `pnpm dev`
# can't silently read or write a stale local copy. There is intentionally no
# local dev DB. To deliberately opt into one, point DATABASE_URL at it and set
# ALLOW_LOCAL_DB=1.
DATABASE_URL="set-by-railway-in-production"
# ALLOW_LOCAL_DB=1

# App
NEXT_PUBLIC_APP_NAME="NativeSpin"

# GetPlatform — central services origin. Used by the public /offer/[token]
# artifact embed to fetch and respond to offers. Defaults to the Railway
# direct URL when unset (Cloudflare strips the API-key header on the proxy).
GETPLATFORM_URL="https://get-platform-production.up.railway.app"

# Public site origin — used for absolute canonical/OpenGraph URLs in
# page metadata. Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL="https://nativespin.com"

# Google Tag Manager. When set, GTM loads with Consent Mode v2 defaulting
# to denied (a CMP deployed via GTM grants consent). Leave unset to ship
# no third-party tags (e.g. local/dev/CI).
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# GetCookies consent banner (CMP). Domain id from getcookies.co → Domains → nativespin.com.
# Unset = no banner and no third-party code.
# NEXT_PUBLIC_GETCOOKIES_DOMAIN_ID=""

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Two-factor authentication (TOTP). Any user can turn it on at
# /account/security. Set MFA_REQUIRED_FOR_STAFF=1 to REQUIRE it for DESK and
# SUPERADMIN: staff without it are redirected to enrol before they can use the
# desk. Leave unset on first deploy so nobody is locked out, let staff enrol,
# then turn it on. TOTP secrets are encrypted under a key derived from
# AUTH_SECRET, so rotating AUTH_SECRET means everyone re-enrols.
# Locked-out user: pnpm tsx scripts/reset-mfa.ts <email> --by <you>
# MFA_REQUIRED_FOR_STAFF=1

# Optional seed overrides for the desk admin account
# DESK_ADMIN_EMAIL="desk@nativespin.com"
# DESK_ADMIN_PASSWORD="nativespin-desk"

# --- Rate limiting (src/lib/rate-limit.ts, src/lib/client-ip.ts) ---
# Buckets are stored in Postgres (table RateLimitBucket) so limits survive
# deploys and hold across instances. "memory" forces the per-process store
# (tests use it automatically); "postgres" forces the durable one.
# RATE_LIMIT_STORE=postgres
# How many trusted reverse proxies sit in front of the app. With N set, the
# client IP is the Nth entry from the RIGHT of X-Forwarded-For, so a
# client-supplied prefix can't spoof it. Unset = leftmost entry (only correct
# if the edge proxy overwrites the header). Verify against real request logs
# before setting: a wrong value keys every limit on the proxy's own address.
# TRUSTED_PROXY_HOPS=1

# --- Auth emails (Resend) ---
# Optional in dev — when unset, emails are logged to the console only.
RESEND_API_KEY=
AUTH_EMAIL_FROM="NativeSpin <noreply@nativespin.com>"
AUTH_EMAIL_REPLY_TO=
AUTH_APP_NAME="NativeSpin"
# Where /contact form messages go (Reply-To is the sender). Defaults to the
# published hello@nativespin.com when unset.
CONTACT_INBOX=

# --- Publisher outreach (rate-card campaign) ---
OUTREACH_DAILY_CAP=20
OUTREACH_HOURLY_CAP=8
OUTREACH_FROM="NativeSpin Partnerships <partnerships@nativespin.com>"
OUTREACH_REPLY_TO=partnerships@nativespin.com

# --- Cloudflare R2 (generic blob storage; used for rate-card PDFs and future placement images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nativespin-blob
R2_PUBLIC_URL=

# --- Accounting integration ---
# Provider selector. Unset/anything but "fiken" → no-op (the structured
# JSON export at /api/export/invoices/accounting.json still works).
# ACCOUNTING_PROVIDER=fiken
# Fiken (Norwegian accounting SaaS) — required only when ACCOUNTING_PROVIDER=fiken.
# The live push is a stub until these are set and the field mapping is
# verified against a Fiken sandbox company.
FIKEN_API_TOKEN=
FIKEN_COMPANY_SLUG=
# Fiken sales/bank account code the invoice posts against (per company).
# FIKEN_BANK_ACCOUNT_CODE=1500:10001

# --- Seller of record on invoices (src/lib/seller.ts) ---
# Invoice PDFs REFUSE to render until the required ones are set: a Norwegian
# sales document must state the seller's org number (+ MVA), address and how
# to pay. The desk sees exactly which are missing on /invoices/<id>.
# Defaults exist only for what the site already states (legal name and seat).
# Required: SELLER_ORG_NUMBER (9 digits, MOD11-checked), SELLER_VAT_NUMBER
# (as printed, e.g. "NO <org number> MVA"), SELLER_ADDRESS_LINE1,
# SELLER_POSTAL_CODE, SELLER_BANK_ACCOUNT (11 digits, MOD11-checked; NOK
# invoices), SELLER_IBAN + SELLER_BIC (every non-NOK invoice; IBAN mod-97-checked).
# SELLER_LEGAL_NAME="Getia AS"
SELLER_ORG_NUMBER=
SELLER_VAT_NUMBER=
# SELLER_REGISTRY="Foretaksregisteret"
SELLER_ADDRESS_LINE1=
# SELLER_ADDRESS_LINE2=
SELLER_POSTAL_CODE=
# SELLER_CITY="Oslo"
# SELLER_COUNTRY="Norway"
SELLER_BANK_ACCOUNT=
SELLER_IBAN=
SELLER_BIC=
# Optional billing contact printed under the seller block.
# SELLER_EMAIL=

# GetTalk booking handle for the help-call nudge (client-readable).
# Set to the desk's claimed gettalk.co handle, e.g. "admirate". Unset = mailto fallback.
NEXT_PUBLIC_GETTALK_USERNAME=

# ---------------------------------------------------------------------------
# Variables below are validated at boot by src/lib/env.ts (keep in sync).
# ---------------------------------------------------------------------------

# Canonical origin used for every emailed link and auth callback
# (src/lib/url.ts: AUTH_URL → NEXTAUTH_URL → NEXT_PUBLIC_SITE_URL). Set in
# production; unset falls back to http://localhost:3000.
# AUTH_URL="https://nativespin.com"

# Resend inbound webhook signing secret (Svix "whsec_…"). Without it
# /api/webhooks/resend rejects every event, so bounces and complaints never
# reach the outreach suppression list.
RESEND_WEBHOOK_SECRET=
# Set to 1 to print full email bodies to the log when RESEND_API_KEY is unset
# (dev only — bodies contain sign-in links).
# EMAIL_LOG_BODY=1

# GetPlatform keys. FEEDBACK_INGEST_KEY is a low-privilege key that can only
# create feedback rows (in-app feedback widget); GETPLATFORM_API_KEY is the
# portfolio key; GETPLATFORM_AI_KEY (falls back to GETPLATFORM_API_KEY)
# authenticates the LLM gateway at GETPLATFORM_AI_URL (defaults to
# GETPLATFORM_URL). Unset = the feature degrades (feedback 503, AI ranking off).
FEEDBACK_INGEST_KEY=
GETPLATFORM_API_KEY=
GETPLATFORM_AI_KEY=
# GETPLATFORM_AI_URL="https://get-platform-production.up.railway.app"

# Metrics-request campaign: max emails per day (default 30) and Reply-To.
# METRICS_DAILY_CAP=30
# METRICS_REPLY_TO=partnerships@nativespin.com

# Feature flag: 1 enables the campaign flow while it is built out.
# CAMPAIGN_FLOW=1

# --- Background sweeps ---
# Each in-process sweep can be switched off with "0" (default: on).
# AUTOSEND_SWEEP=0
# METRICS_SWEEP=0
# PRICE_BAND_SWEEP=0
# PLACEMENT_READY_SWEEP=0
# Daily data-retention sweep (src/lib/retention.ts): deletes spent sign-in /
# reset / email-change tokens, dead invites and old idempotency keys, and
# scrubs IPs and email addresses out of audit rows older than 90 days.
# RETENTION_SWEEP=0
# To run the sweeps from an external scheduler instead of in-process timers:
# set CRON_SECRET (>= 24 chars, e.g. `openssl rand -base64 32`), have the
# scheduler POST /api/cron/sweeps hourly with `Authorization: Bearer <secret>`,
# then set IN_PROCESS_SWEEPS=0. With CRON_SECRET unset the endpoint is a 404.
CRON_SECRET=
# IN_PROCESS_SWEEPS=0
# The durable job queue (queued webhook deliveries, email retries, invoice
# archiving, accounting retries — see /desk/jobs) is polled every 10 s inside
# the web process. JOB_WORKER=0 turns that poller off; then a scheduler must
# POST /api/cron/sweeps?only=jobs every minute or queued work only runs on its
# first, immediate attempt. CRON_SECRET also guards GET /api/health/deep.
# JOB_WORKER=0

# --- Alerting ---
# Slack- or Discord-compatible incoming webhook. Every error-level log line
# (unhandled request errors, crashed or partially failed sweeps, failed
# invoice pushes …) posts a one-line alert here, rate-limited to 5 per 5 min.
# Unset = errors are only written to the log.
ERROR_WEBHOOK_URL=

# --- AI (LLM gateway) models and budgets (src/lib/ai-config.ts) ---
# Gateway model slug per feature; the defaults are shown.
# AI_MODEL_BRIEF_MATCH="claude-sonnet-4-6"
# AI_MODEL_BRIEF_RERANK="claude-haiku-4-5"
# AI_MODEL_PREVIEW="claude-sonnet-4-6"
# LLM calls allowed per UTC day, counted in the database (AiCallLog). Over
# budget the AI paths are skipped and the deterministic results are used.
# AI_DAILY_BUDGET_GLOBAL=3000
# AI_DAILY_BUDGET_PER_ORG=300
