# Copy to .env and adjust. Postgres connection for Prisma.
# Local docker-compose default (Postgres user/db names kept as 'atnative'
# from the docker-compose volume — renaming them would require dropping
# the dev volume and re-seeding. Safe to leave as internal infra names).
DATABASE_URL="postgresql://atnative:atnative@127.0.0.1:5432/atnative?schema=public"

# App
NEXT_PUBLIC_APP_NAME="NativeSpin"

# Public site origin — used for absolute canonical/OpenGraph URLs in
# page metadata. Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL="https://nativespin.com"

# Google Tag Manager. When set, GTM loads with Consent Mode v2 defaulting
# to denied (a CMP deployed via GTM grants consent). Leave unset to ship
# no third-party tags (e.g. local/dev/CI).
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Optional seed overrides for the desk admin account
# DESK_ADMIN_EMAIL="desk@nativespin.com"
# DESK_ADMIN_PASSWORD="nativespin-desk"

# --- Auth emails (Resend) ---
# Optional in dev — when unset, emails are logged to the console only.
RESEND_API_KEY=
AUTH_EMAIL_FROM="NativeSpin <noreply@nativespin.com>"
AUTH_EMAIL_REPLY_TO=
AUTH_APP_NAME="NativeSpin"

# --- Publisher outreach (rate-card campaign) ---
OUTREACH_DAILY_CAP=20
OUTREACH_HOURLY_CAP=8
OUTREACH_FROM="NativeSpin Partnerships <partnerships@nativespin.com>"
OUTREACH_REPLY_TO=partnerships@nativespin.com

# --- Cloudflare R2 (generic blob storage; used for rate-card PDFs and future placement images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nativespin-blob
R2_PUBLIC_URL=

# --- Accounting integration ---
# Provider selector. Unset/anything but "fiken" → no-op (the structured
# JSON export at /api/export/invoices/accounting.json still works).
# ACCOUNTING_PROVIDER=fiken
# Fiken (Norwegian accounting SaaS) — required only when ACCOUNTING_PROVIDER=fiken.
# The live push is a stub until these are set and the field mapping is
# verified against a Fiken sandbox company.
FIKEN_API_TOKEN=
FIKEN_COMPANY_SLUG=
