// NativeSpin data model — see PLAN.md §8.
// Covers the full lifecycle: catalog (Market/Publisher/Title/Product/PriceRule/
// Spec), commerce (Plan/Request/Quote/Order/Invoice/CreditNote), content
// production (ContentBrief/ContentAsset), multi-tenant orgs, the public API,
// and the publisher-outreach engine (SalesContact/RateCardRequest/PriceRequest).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum PriceResponseSource {
  LINK_FORM
  MANUAL_EMAIL
  MANUAL_PHONE
  MANUAL_OTHER
}

enum MarketCode {
  NO
  SE
  DK
  FI
  DE
  AT
  CH
  UK
  IE
  NL
  BE
}

enum ProductType {
  NATIVE_ARTICLE
  ADVERTORIAL
  NATIVE_DISPLAY
  PACKAGE
  CONTEXTUAL
  OTHER
  // Shoppable native article — in-article product links / buy buttons.
  NATIVE_PLUS
  // Video-led sponsored placement in the publisher's player/feed.
  CONTENT_VIDEO
}

enum PricingModel {
  FLAT
  CPM
  CPC
  PACKAGE
}

// A quote/order line is either inventory (a publisher placement, priced
// from the rate card with a margin) or a content-production fee (our
// service revenue, priced from a ContentFeeRule). Splitting the two lets
// reporting separate buying margin from content-fee revenue — the
// "margin vs content fee" emphasis the business steers on.
enum LineKind {
  INVENTORY
  CONTENT_FEE
}

// Who writes the article for a placement — a separate axis from LineKind
// (which is billing: a publisher placement vs our content-production fee).
// Carried Plan→Order so a confirmed order records production intent instead
// of leaving "buyer brought their own copy" and "publisher produces it" as
// indistinguishable rows. BUYER_SUPPLIED is the historical withContent=false
// default; NATIVESPIN_PRODUCED maps to withContent=true (drives the
// CONTENT_FEE line + writer staffing); PUBLISHER_PRODUCED has no buyer toggle
// yet but is modelled now so the record can represent it without a later split.
enum AuthorshipMode {
  BUYER_SUPPLIED
  NATIVESPIN_PRODUCED
  PUBLISHER_PRODUCED
}

enum PriceVisibility {
  INDICATIVE
  FIRM
}

enum OrgType {
  ADVERTISER
  AGENCY
}

enum UserRole {
  BUYER
  APPROVER
  ORG_ADMIN
  DESK
  CONTENT
  PUBLISHER
  SUPERADMIN
}

enum MembershipRole {
  ADMIN
  MEMBER
  RESTRICTED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  QUOTED
  CLOSED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  DECLINED
}

enum OrderStatus {
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  SCHEDULED
  LIVE
  COMPLETED
  INVOICED
  CANCELLED
}

enum ContentAssetStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  FINAL
  // Publisher invoked editorial veto — the draft is hard-rejected, not
  // a soft "please tweak". Asset row stays for audit; status flag keeps
  // it out of any "current asset" picker.
  RETRACTED
}

enum BookingStatus {
  PENDING
  BOOKED
  PUBLISHED
  CONFIRMED
  CANCELLED
}

enum MetricsSource {
  SYSTEM          // snapshot-only writes (freeze); ranked lowest so a later real reading always overwrites the live fields
  PUBLISHER       // legacy (pre-campaign-reporting rows); migrated to PUBLISHER_FORM. Kept so the Prisma enum matches the DB type (Postgres can't drop an enum value).
  PUBLISHER_FORM  // tokenized self-serve form (publisher typed it)
  PUBLISHER_EMAIL // AI-transcribed from a publisher email reply (authoritative; raw snippet in note)
  DESK            // manual entry / override (wins on a mis-parse)
}

enum MetricsRequestStatus {
  NEEDS_CONTACT // no resolvable contact — surfaced to desk, not sent
  PENDING
  PARTIAL
  COMPLETE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
  CREDITED
}

enum NotificationKind {
  RFQ_SUBMITTED
  QUOTE_READY
  QUOTE_ACCEPTED
  BOOKING_NEW
  BOOKING_CONFIRMED
  ASSET_REVIEW
  INVOICE_ISSUED
  // Publisher editorial firewall fired — distinct from ASSET_REVIEW so
  // the buyer's dashboard can surface it as a hard event, not another
  // "please tweak" nudge.
  EDITORIAL_VETO
  // Order moved to CANCELLED state (any cause: editorial veto, buyer
  // pull-out, desk decision). Buyer + publisher get this so they're not
  // surprised by the missing booking.
  ORDER_CANCELLED
  // The desk acted on a title PLACEHOLDER the buyer asked it to propose —
  // either picked a concrete placement, or removed a placeholder with no
  // bookable option. The buyer asked the desk to decide; this is the signal back.
  PLACEMENT_PROPOSED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Languages writers produce content in — matches the src/messages locale
// set (no, sv, da, fi, de, en). Distinct from MarketCode because several
// markets share a language (DE/AT/CH → DE, UK/IE → EN).
enum ContentLanguage {
  NO
  SV
  DA
  FI
  DE
  EN
}

enum LanguageProficiency {
  NATIVE
  FLUENT
  WORKING
}

// Editorial specialty taxonomy for writer matching. Enum for v1 (simple,
// filterable); promote to a Topic table only if the desk needs to add
// categories itself.
enum ContentTopic {
  FINANCE
  HEALTH
  TECH
  LIFESTYLE
  B2B
  TRAVEL
  FOOD
  CULTURE
  SUSTAINABILITY
  OTHER
}

// ---------- Catalog ----------

model Market {
  id           String     @id @default(cuid())
  code         MarketCode @unique
  name         String
  currency     String // ISO 4217, e.g. NOK / SEK / DKK
  defaultLocale String    @default("en")
  vatRatePct   Decimal    @db.Decimal(5, 2)
  // Per-PLAN §13: native/sponsored disclosure label required for the
  // market (NO: "Annonsørinnhold", SE: "Annons", DK: "Annonce"). Used by
  // the spec-check as a market-wide minimum even when a Title hasn't
  // configured its own.
  disclosureLabel String?
  // EUR conversion rate for cross-market campaign size display. Stored
  // as "1 unit of local currency = X EUR" so the math is a single
  // multiply at render time. NULL means the market is already EUR
  // (DE / AT / IE / FI). Buyer-facing only — local currency stays
  // canonical at the quote/invoice layer. Desk edits the rate weekly
  // until we wire to an ECB feed.
  fxToEUR         Decimal? @db.Decimal(12, 6)
  // Ad categories restricted/banned by local marketing law. Values follow
  // the RestrictedCategory convention: GAMBLING, ALCOHOL, TOBACCO,
  // PRESCRIPTION_DRUGS, POLITICAL. Display-only today (title detail
  // "Rules in this market" card) — enforced in the brief flow later.
  restrictedCategories String[] @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  publishers Publisher[]
  titles     Title[]
}

model Publisher {
  id            String   @id @default(cuid())
  name          String
  // Denormalized ISO country code mirroring `market.code`. Kept as a
  // first-class column so catalog filtering can hit an index without
  // joining Market.
  countryCode   String
  marketId      String
  market        Market   @relation(fields: [marketId], references: [id])
  contactEmail  String?
  paymentTerms  String? // e.g. "net 30"
  contractNotes String?
  // Master switch for buyer-facing price visibility. When false,
  // every title under this publisher renders as "Request price" in
  // the catalog / recommender / public API — the desk still sees
  // and quotes from internal prices as normal. Used when a publisher
  // is onboarded under NDA or wants RFQ-only positioning.
  pricesPublic  Boolean  @default(true)
  // Optional brand logo for the marketing proof strip. Null → the strip
  // renders a styled text chip of the publisher name instead, so the
  // component is truthful with zero assets and logos drop in later.
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  titles             Title[]
  users              User[]
  invites            PublisherInvite[]
  salesContacts      SalesContact[]
  contactCandidates  ContactCandidate[]
  apiKeys            ApiKey[]
  rateCardDocuments  RateCardDocument[]
  bookings           PublisherBooking[]
  metricsRequests    MetricsRequest[]

  @@unique([marketId, name])
  @@index([countryCode])
}

model Title {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  publisherId   String
  publisher     Publisher @relation(fields: [publisherId], references: [id])
  // Publisher's own identifier for this title, used by the programmatic
  // ingestion API to upsert idempotently. Unique per publisher; null for
  // titles created via the CSV import or the manual desk flow.
  externalRef   String?
  // Denormalized ISO country code mirroring `market.code`. Kept so
  // catalog filtering by country hits an index without joining Market.
  countryCode   String
  marketId      String
  market        Market    @relation(fields: [marketId], references: [id])
  category      String // e.g. "general-news", "business", "lifestyle"
  audienceNote  String?
  // Combined print + digital monthly readers (legacy seed estimate).
  // Kept for desk/internal use; the customer-facing catalog should
  // prefer `digitalReach` once it's populated.
  monthlyReach  Int?
  // Pure digital monthly visitors / unique readers on the title's
  // website. This is what marketing/agency prospects actually care
  // about because the marketplace doesn't sell print. Populated from
  // SimilarWeb / publisher analytics; null until seeded.
  digitalReach  Int?
  websiteUrl    String?
  active        Boolean   @default(true)
  lastVerifiedAt DateTime?
  // Positive verification of whether the publication is *still in production*.
  // `active`/`discontinuedAt` only record deactivation; this records the
  // opposite too — that we actively CONFIRMED a title is live (not merely that
  // nobody has flagged it). UNVERIFIED is the honest default: do not trust a
  // title until it is positively confirmed. verificationSource holds the URL /
  // reply backing the status; lastVerifiedAt holds when it was checked.
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationSource String?
  // Set when a publisher confirms a title is defunct (no longer exists /
  // merged into another title). We also set active=false, but these two
  // fields preserve *that* and *why* it was discontinued for the future —
  // distinct from a temporary deactivation. discontinuedNote records what
  // replaced it (e.g. "merged into lørdagsavisen") and the source.
  discontinuedAt   DateTime?
  discontinuedNote String?
  // Public rate-card price for a standard sponsored placement on
  // this title — the number the publisher publishes on their media
  // kit. Used as the *anchor* on customer-facing quotes
  // ("Rate card €X → your price €Y"). Editorial input only; the
  // commerce price still flows via Product.basePrice + PriceRule.
  publishedRateCard     Decimal? @db.Decimal(12, 2)
  publishedRateCurrency String?  // ISO 4217; falls back to market currency at render time
  // Per-title price-visibility switch. AND-ed with publisher.pricesPublic
  // at render time. False → catalog / recommender / public API hide
  // every euro figure for this title and surface "Request price"
  // instead. Self-serve FIRM checkout is also blocked for hidden
  // titles so the buyer never sees a price they shouldn't.
  pricesPublic          Boolean  @default(true)
  // Publication-level default for the content-production fee. Null =
  // inherit from the desk ContentFeeRule price list.
  productionFeeDefault Decimal? @db.Decimal(12, 2)
  // ---------- CSV import fields (research catalog) ----------
  // Populated from prisma/data/medier_alle.csv. These are descriptive
  // metadata used to power filtering/search in the catalog UI; they do
  // not gate the commerce model (which still flows via Product/Spec).
  type          String? // CSV "Type" — Avis, Magazine, Monthly mag, Digital, ...
  frequency     String? // CSV "Frequency" — Daglig, Ukentlig, Monthly, ...
  ownerGroup    String? // CSV "Owner (group)" — Polaris Media, Schibsted, ...
  publisherName String? // CSV "Publisher" — raw publisher string (the FK Publisher is for commerce)
  // DEPRECATED — superseded by the SalesContact join (see SalesContactTitle).
  // Kept to preserve CSV import lineage. Will be dropped once admin has
  // finished curating SalesContact rows for every active title.
  adSales       String?
  // Clean, queryable classification of `adSales` — drives outreach routing
  // and the desk "direct or not" badge. Backfilled from `adSales`.
  salesChannel  SalesChannel?
  locationNote  String? // CSV "Location / Note" — city or short note
  // Structured geo derived from locationNote where confident (Title geo
  // enrichment). Null when national/unknown; locationNote stays the raw note.
  city          String?
  region        String?
  circulation   Int?    // CSV "Circulation"
  vertical      String? // CSV "Vertical" — News (National), B2B – Energy, ...
  audience      String? // CSV "Audience" — General consumer, Regional consumer, ...
  b2bB2c        String? // CSV "B2B/B2C"
  reach         String? // CSV "Reach" — National / Regional / Local / Niche
  format        String? // CSV "Format" — Print + Digital / Print / Digital
  nativeFit     String? // CSV "Native fit" — High / Medium / Low
  tags          String? // CSV "Tags" — comma-separated tag list
  urlStatus     String? // CSV "URL_status" — VERIFIED / LIKELY_OK / UNVERIFIED
  // ---------- Commercial profile (rate-card ingestion) ----------
  // Can the advertiser deliver its own article content for this
  // publication? UNKNOWN until captured from a rate card / reply.
  ownContentAllowed OwnContent @default(UNKNOWN)
  // Free-text description of the publication's content policy (e.g.
  // labelling rules, editorial approval, off-limits topics).
  contentPolicy     String?
  // Catch-all for any captured commercial info that has no structured
  // column yet, so nothing from a media kit is ever lost. Recurring
  // keys get promoted to real columns over time.
  commercialExtra   Json?
  // Structured list of commercial info we still need from this title —
  // e.g. ["display CPM", "nyhetsbrev ukespris"]. A publisher may *offer*
  // a format without giving us the number; we record that gap here
  // (queryable) instead of burying it in commercialExtra freetext, and it
  // drives the gap follow-up emails. Empty = nothing outstanding.
  outstandingInfo   String[]
  // Whether this title offers advertiser content (annonsørinnhold / native
  // article / sponsored content) at all. null = unknown (not yet
  // confirmed), true = offered, false = explicitly does NOT offer it (e.g.
  // display banners only). Confirmed from publisher replies. Surfaced so we
  // never re-ask a title that has told us they don't do native.
  offersNativeContent Boolean?
  // Recurring commercial metrics that show up across many media kits —
  // structured (not buried in commercialExtra) so they're queryable and
  // comparable across publishers. Null = not provided.
  facebookFollowers   Int?
  instagramFollowers  Int?
  // Agency commission (byråprovisjon) as a percentage, e.g. 3.50.
  agencyCommissionPct Decimal? @db.Decimal(5, 2)
  // Alternative names / spellings / brand names this title is known by
  // (e.g. TU.no ← "Teknisk Ukeblad"; Tidende ← "NTFs Tidende",
  // "Tannlegetidende"). Checked during ingest/import so we match an
  // existing title instead of creating a duplicate.
  aliases       String[]
  // Curated, queryable search tags (the legacy `tags` string is CSV-import
  // lineage; prefer this structured array going forward).
  keywords      String[]
  // Human-written description of the title — who it reaches and what it's
  // about — enriched as we learn more from publisher replies/media kits.
  description   String?
  // Internal (desk-only): the date the current pricing/commercial data on
  // this title is from — typically the publisher reply / rate-card received
  // date. Lets the desk judge at a glance whether prices are current or
  // stale. Distinct from `lastVerifiedAt` (which also drives catalog
  // visibility). Never shown to consumers.
  pricingAsOf   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products          Product[]
  salesContactLinks SalesContactTitle[]
  priceRequests     PriceRequest[]
  rateCardRequests  RateCardRequestTitle[]
  contactLogs       ContactLog[]
  rateCardDocuments RateCardDocument[]
  bookings          PublisherBooking[]
  savedListItems    SavedListItem[]
  favorites         Favorite[]

  @@index([countryCode])
  @@index([type])
  @@index([category])
  @@index([vertical])
  @@index([b2bB2c])
  @@index([nativeFit])
  @@index([format])
  @@index([reach])
  @@index([frequency])
  @@index([ownerGroup])
  @@index([salesChannel])
  @@index([city])
  @@index([region])
  @@unique([publisherId, externalRef])
}

model Product {
  id           String          @id @default(cuid())
  titleId      String
  title        Title           @relation(fields: [titleId], references: [id])
  type         ProductType
  name         String
  description  String?
  // Publisher's own SKU for this product, for idempotent ingestion.
  // Unique within a title; null for non-ingested products.
  externalRef  String?
  pricingModel PricingModel    @default(FLAT)
  basePrice    Decimal         @db.Decimal(12, 2)
  currency     String // ISO 4217, normally inherited from Market
  visibility   PriceVisibility @default(INDICATIVE)
  // Null = publisher has not stated a lead time. Never invent one — the
  // card hides the row instead of showing a platform guess as fact.
  leadTimeDays Int?
  active       Boolean         @default(true)
  bookable     Boolean         @default(true)
  confirmedAt     DateTime?
  confirmedSource String?   // e.g. "PriceQuote:abc123", "manual", "blueprint-legacy"
  // Publisher-stated inclusions/exclusions, copied verbatim from the
  // applied PriceQuote so the catalog can show what the MEDIA says the
  // price covers (never a platform claim).
  includedText  String?
  excludedText  String?
  // Semantic, buyer-exposable inclusions — the ONLY per-product facts a
  // buyer sees beyond name/type/band. Structured ({ production, viewsPerWeek,
  // frontpage, newsletter, ... }) and rendered via i18n templates, so one
  // data entry serves every locale. Internal quote text stays desk-only.
  inclusions Json?
  // Per-offer override of the content-production fee folded into the
  // displayed all-in band. Null = inherit (Title default → ContentFeeRule);
  // 0 = publisher includes production in basePrice.
  productionFee Decimal? @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  priceRules    PriceRule[]
  spec          Spec?
  availability  Availability[]
  priceQuotes   PriceQuote[]
  savedListItems SavedListItem[]

  @@unique([titleId, externalRef])
}

// Phase-3 availability calendar — a product is bookable for a given
// (year, month) unless a row exists with `blocked = true`. Sold-out /
// editorial-closed windows surface to buyers in the catalog and stop
// `submitRequest` for FIRM-priced items.
model Availability {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  year      Int
  month     Int // 1-12
  blocked   Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, year, month])
  @@index([productId])
}

model PriceRule {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  label              String   @default("default")
  marginPct          Decimal  @default(15) @db.Decimal(5, 2)
  seasonalMultiplier Decimal  @default(1) @db.Decimal(5, 2)
  minVolume          Int      @default(1)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Spec {
  id           String   @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
  wordCountMin Int?
  wordCountMax Int?
  imagesMin    Int?     @default(1)
  disclosureLabel String? // required sponsored/native marking text
  fileFormats  String? // e.g. "JPG, PNG"
  requirements String? // free-form additional requirements
  // Content Video specs (null for non-video formats).
  videoMaxSeconds Int?    // max length in seconds, e.g. 60
  videoHosting    String? // accepted hosting/format, e.g. "YouTube, Vimeo, or MP4 ≤ 200 MB"
  // Native Plus (shoppable) specs (null for non-shoppable formats).
  shoppableMaxProducts Int?    // max in-article product links/cards, e.g. 3
  ctaGuidance          String? // allowed/required buy-button CTA wording
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Desk-owned price list for NativeSpin's own content-production service.
// This is *our* revenue, not the publisher's — kept off Product (which
// publishers edit). When a quote line is produced for a placement the
// buyer wants us to write, we look up the most-specific active rule:
//   (productType + marketCode) > productType > marketCode > global
// and bill `greenfieldFee` (or `adaptationFee` when the asset reuses an
// existing one via ContentAsset.sourceAssetId).
model ContentFeeRule {
  id            String       @id @default(cuid())
  // Both nullable — null = "applies to any". A rule with both null is
  // the global fallback. Most-specific active match wins.
  marketCode    MarketCode?
  productType   ProductType?
  currency      String // ISO 4217
  greenfieldFee Decimal      @db.Decimal(12, 2)
  // Charged instead of greenfieldFee when adapting an existing asset for
  // a new market. Null → fall back to greenfieldFee.
  adaptationFee Decimal?     @db.Decimal(12, 2)
  active        Boolean      @default(true)
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([active, productType, marketCode])
}

// Desk-owned default commission (%) applied when a product carries no
// PriceRule of its own. Null marketCode = global fallback; the
// most-specific active match wins (market beats global). With no rows
// the code falls back to the hardcoded 15 (DEFAULT_MARGIN_PCT), so an
// empty table changes nothing.
model MarginRule {
  id         String      @id @default(cuid())
  marketCode MarketCode?
  marginPct  Decimal     @db.Decimal(5, 2)
  active     Boolean     @default(true)
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([active, marketCode])
}

// Phase 4 — content playbooks. Desk-owned, reusable guidance for what
// makes good native for a given format / category / market. The most
// specific active match surfaces to the writer when a ContentBrief is
// created, closing the optimization loop: benchmarks & pricing inform
// price; playbooks codify the content that wins.
model Playbook {
  id               String       @id @default(cuid())
  // All three nullable — null = "applies to any". Most-specific active
  // match wins (productType weighted highest, then category, then market).
  productType      ProductType?
  category         String?
  marketCode       MarketCode?
  title            String
  angle            String?      // the persuasion angle that works here
  structure        String?      // recommended article structure
  doList           String?      // newline-separated do's
  dontList         String?      // newline-separated don'ts
  exampleHeadlines String?      // newline-separated example headlines
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([active, productType, category, marketCode])
}

// ---------- Accounts ----------

model Organization {
  id            String   @id @default(cuid())
  name          String
  type          OrgType
  // Nullable so signup can defer this to onboarding — the legal-entity
  // home market drives VAT / invoice locale / default currency but it's
  // not needed at moment-of-account-creation. Onboarding makes this
  // required before the user can submit an RFQ.
  marketCode    MarketCode?
  vatId         String?
  parentOrgId   String?
  parentOrg     Organization?  @relation("AgencyClients", fields: [parentOrgId], references: [id])
  clients       Organization[] @relation("AgencyClients")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  plans       Plan[]
  requests    Request[]
  orders      Order[]
  invoices    Invoice[]
  apiKeys     ApiKey[]
  memberships Membership[]
  invites     OrgInvite[]
  savedLists  SavedList[]
  favoriteLists FavoriteList[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  phone          String?
  passwordHash   String?
  role           UserRole     @default(BUYER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  publisherId    String?
  publisher      Publisher?   @relation(fields: [publisherId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  emailVerifiedAt DateTime?
  lastSignInIp    String?
  lastSignInAt    DateTime?
  bookingPromptDismissedAt DateTime?

  notifications          Notification[]
  magicLinkTokens        MagicLinkToken[]
  passwordResetTokens    PasswordResetToken[]
  priceRequestsRequested PriceRequest[]     @relation("PriceRequestRequester")
  priceQuotesApplied     PriceQuote[]       @relation("PriceQuoteApplier")
  rateCardRequests       RateCardRequest[]  @relation("RateCardRequestCreator")
  memberships            Membership[]       @relation("UserMemberships")
  invitedMembers         Membership[]       @relation("MembershipInviter")
  contactLogs            ContactLog[]       @relation("ContactLogAuthor")
  writerProfile          WriterProfile?
  metricsRequests        MetricsRequest[]   @relation("MetricsRequestCreator")
  favorites              Favorite[]
  favoriteLists          FavoriteList[]
}

// Super-admin emits these when activating a new publishing house in
// the catalog. The publisher commercial-lead clicks the tokenised link
// and lands on a signup page that binds the new User to the
// pre-existing Publisher record. Token is single-use and time-limited.
//
// Closes Ingrid's scenario gap (super-admin had no
// sendPublisherInvite action and was manually drafting partner emails).
model PublisherInvite {
  id              String    @id @default(cuid())
  publisherId     String
  publisher       Publisher @relation(fields: [publisherId], references: [id])
  email           String
  token           String    @unique
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?
  createdBy       String
  createdAt       DateTime  @default(now())

  @@index([publisherId])
  @@index([email])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole   @default(MEMBER)
  canCommit      Boolean          @default(false)
  expiresAt      DateTime?
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  invitedBy      User?            @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
}

model OrgInvite {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email               String
  role                MembershipRole  @default(MEMBER)
  canCommit           Boolean         @default(false)
  delegationExpiresAt DateTime?
  token               String          @unique
  expiresAt           DateTime
  claimedAt           DateTime?
  claimedByUserId     String?
  createdById         String
  createdAt           DateTime        @default(now())

  @@index([organizationId])
  @@index([email])
}

// Scraper output queued for admin review. Approved candidates become SalesContact rows.
model ContactCandidate {
  id             String          @id @default(cuid())
  publisherId    String
  publisher      Publisher       @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  role           String?
  phone          String?
  sourceUrl      String
  confidence     Int
  status         CandidateStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  salesContactId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([publisherId, email])
  @@index([status])
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

// How a title's advertising is sold — the "direct or not" axis for outreach.
// Derived from the CSV `adSales` string; see prisma/migrations backfill.
//   DIRECT   — the publisher sells its own ads; contact the title directly.
//   IN_HOUSE — the publisher *group's* own ad department (Bonnier News
//              Brands, Amedia Salg, Schibsted SMS, …). Not a third party —
//              the most direct route that exists for those titles.
//   REP      — an independent third-party rep house representing unrelated
//              titles (HS Media, A2 Media, Salgsfabrikken, Iconic). True
//              middleman.
enum SalesChannel {
  DIRECT
  IN_HOUSE
  REP
}

// In-DB notification inbox. The email adapter (src/lib/notify.ts) also
// fires on create, but this row is the source of truth — UI reads it,
// and a real email provider just needs to swap the adapter.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// API key for the public catalog read API (/api/v1/catalog/*).
// Each key is owned by an Organization (agency or advertiser) — see
// Tobias's GroupM scenario for the canonical use case. The stored
// `tokenHash` is the SHA-256 of the raw token; the raw value is only
// shown to the creator at issuance.
//
// Scopes are kept as a comma-separated string for v1 — a JSON array
// column would be cleaner but the only scope today is "catalog:read"
// and a future migration can normalise once we add more.
model ApiKey {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  // Set for publisher ingestion keys: the key may only read/write this
  // publisher's inventory (hard multi-tenant boundary). Null for the
  // existing buyer/partner catalog:read keys.
  publisherId    String?
  publisher      Publisher?    @relation(fields: [publisherId], references: [id])
  // Human label so super-admin can rotate per integration partner.
  name           String
  // SHA-256 of the raw token (hex). Never store the raw value.
  tokenHash      String        @unique
  // Comma-separated scopes; "catalog:read" (buyer/partner reads) and
  // "catalog:write" (publisher ingestion) are the v1 values.
  scopes         String        @default("catalog:read")
  createdBy      String
  createdAt      DateTime      @default(now())
  lastUsedAt     DateTime?
  // Nullable: explicit no-expiry for trusted partner agencies; the
  // super-admin UI surfaces lastUsedAt + a "rotate" affordance instead
  // of forcing a TTL.
  expiresAt      DateTime?
  revokedAt      DateTime?

  webhooks PartnerWebhook[]

  @@index([organizationId])
  @@index([publisherId])
  @@index([revokedAt])
}

// Partner-program webhook subscription (v0). Lets an API-key holder
// subscribe to catalog-state events (title activated / deactivated /
// price changed) so they don't need to poll. v0 ships a single in-
// process delivery attempt with HMAC-SHA256 signing of the body; if
// the receiver returns non-2xx we record `lastErrorAt` + `lastErrorBody`
// and leave it to the partner to inspect via the desk console. No
// automatic retry queue + no replay endpoint yet — both are tracked
// as follow-up. The model is shaped so adding a retry job later is a
// schema-stable change (deliveryAttempts + queueRetryAt fields).
model PartnerWebhook {
  id             String   @id @default(cuid())
  apiKeyId       String
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  // Comma-separated event types. v0 known kinds: "title.activated",
  // "title.deactivated", "title.price_changed". Receivers MUST tolerate
  // unknown future event kinds rather than 4xx them.
  events         String   @default("title.activated,title.deactivated")
  targetUrl      String
  // 32 bytes hex — used for HMAC-SHA256 of the JSON body. Issued at
  // create time, surfaced once via the same flash-cookie pattern as
  // raw API tokens. Rotation = create new webhook, delete old.
  secretHash     String
  createdBy      String
  createdAt      DateTime @default(now())
  lastDeliveryAt DateTime?
  lastErrorAt    DateTime?
  lastErrorBody  String?
  disabledAt     DateTime?

  @@index([apiKeyId])
  @@index([disabledAt])
}

// Async job queue. Phase 0 ships an in-process runner (src/lib/jobs.ts);
// swapping to BullMQ later only needs a new runner — the writers don't
// change. Rows are kept for observability/audit.
model Job {
  id        String    @id @default(cuid())
  kind      String
  payload   String // JSON
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  runAt     DateTime  @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

// ---------- Plan -> Request -> Quote -> Order ----------

model Plan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String       @default("Untitled plan")
  budget         Decimal?     @db.Decimal(12, 2)
  currency       String?
  startDate      DateTime?
  endDate        DateTime?
  audienceNote   String?
  goal           String?
  // Structured campaign targeting intent — what the buyer wants to reach.
  // Descriptive (used by the desk to pick titles); NOT an ad-server audience.
  targetGeo      String? // markets/regions chosen, comma-separated
  targetAudience String? // audience-segment labels, comma-separated
  targetContext  String? // categories/verticals, comma-separated
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items   PlanItem[]
  request Request?
}

model PlanItem {
  id        String  @id @default(cuid())
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id])
  productId String?
  titleId   String?
  quantity  Int     @default(1)
  // When true, the buyer wants NativeSpin to produce the native content
  // for this placement — adds a CONTENT_FEE line to the quote priced
  // from the matching ContentFeeRule. Per-placement: some buyers bring
  // their own copy. The v1 input for `authorshipMode` (kept as a shim
  // until the UI exposes the full mode selector).
  withContent Boolean @default(false)
  // Canonical authorship intent for this placement, projected from
  // withContent today. Persisted (not just derived) so it can be carried
  // onto the OrderLine at confirmation.
  authorshipMode AuthorshipMode @default(BUYER_SUPPLIED)
  notes     String?
}

model SavedList {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String    @default("Untitled list")
  note           String?
  budget         Decimal?  @db.Decimal(12, 2)
  currency       String?
  goal           String?
  audienceNote   String?
  targetGeo      String?
  targetAudience String?
  targetContext  String?
  // Soft reference (no FK) — the list survives if the creating user is removed.
  createdById    String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items   SavedListItem[]
  requests Request[]

  @@index([organizationId, archivedAt])
}

model SavedListItem {
  id        String    @id @default(cuid())
  listId    String
  list      SavedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  titleId   String?
  title     Title?    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  quantity  Int       @default(1)
  withContent    Boolean        @default(false)
  authorshipMode AuthorshipMode @default(BUYER_SUPPLIED)
  notes     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  // NULL-distinct uniques: a list holds each product / each title at most once
  // (the add path upserts on these). Postgres treats NULL as distinct, so the
  // many title rows (productId NULL) / product rows (titleId NULL) never collide.
  // The exactly-one-of(productId,titleId) CHECK lives in the migration SQL
  // (Prisma can't model CHECK constraints).
  @@unique([listId, productId])
  @@unique([listId, titleId])
  @@index([listId, sortOrder])
}

model Request {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  planId         String        @unique
  plan           Plan          @relation(fields: [planId], references: [id])
  status         RequestStatus @default(DRAFT)
  briefSummary   String?
  assignedDeskUserId String?
  sourceListId   String?
  sourceList     SavedList? @relation(fields: [sourceListId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quotes Quote[]
}

model Quote {
  id          String      @id @default(cuid())
  requestId   String
  request     Request     @relation(fields: [requestId], references: [id])
  status      QuoteStatus @default(DRAFT)
  currency    String
  subtotal    Decimal     @db.Decimal(12, 2)
  vatPct      Decimal     @db.Decimal(5, 2)
  total       Decimal     @db.Decimal(12, 2)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines QuoteLine[]
  order Order?
}

model QuoteLine {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id])
  kind          LineKind @default(INVENTORY)
  // Null for CONTENT_FEE lines — those bill our production service, not
  // a publisher placement.
  productId     String?
  description   String
  quantity      Int      @default(1)
  // For INVENTORY: the publisher's rate-card cost. For CONTENT_FEE: our
  // cost basis (0 unless we want to track writer cost), so margin
  // reporting treats the whole fee as revenue.
  unitCost      Decimal  @db.Decimal(12, 2)
  marginPct     Decimal  @db.Decimal(5, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)
  availability  String?
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  quoteId        String       @unique
  quote          Quote        @relation(fields: [quoteId], references: [id])
  status         OrderStatus  @default(QUOTED)
  // Set when the order moves to CANCELLED. Free-text reason and the
  // role that invoked the cancellation (DESK | PUBLISHER | BUYER) so
  // we can defend the decision against any later customer dispute.
  cancelledAt    DateTime?
  cancelReason   String?
  cancelledBy    String?
  // Free-text desk note on the post-order follow-up commitment to the
  // buyer ("Q1-2027 Berlingske Weekend contingent on Q3 KPI" — Petter's
  // scenario). Lives on the order so the relationship history travels
  // with the customer file rather than rotting in the desk associate's
  // head when they change role. Buyer-visible.
  nextEngagementNote String?
  // Actual paid-media flight window (defaulted from the Plan on creation).
  // Drives the advertiser report window and the end-of-campaign scan.
  // Publisher article run (PublisherBooking.liveEndDate) may extend past this.
  flightStartDate    DateTime?
  flightEndDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lines           OrderLine[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  writerPool      OrderWriterPool[]
  metricsRequests MetricsRequest[]

  @@index([flightEndDate])
}

model OrderLine {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  kind      LineKind @default(INVENTORY)
  // Who writes the article. Carried from the PlanItem at order creation so
  // the confirmed order records production intent. Gates writer staffing —
  // only NATIVESPIN_PRODUCED lines may be assigned a writer.
  authorshipMode AuthorshipMode @default(BUYER_SUPPLIED)
  // Null for CONTENT_FEE lines (no publisher placement to fulfil).
  productId String?
  quantity  Int      @default(1)
  lineTotal Decimal  @db.Decimal(12, 2)
  assignedWriterId String?
  assignedWriter   WriterProfile? @relation("LineAssignedWriter", fields: [assignedWriterId], references: [id])
  assignedAt       DateTime?
  // Desk user who made the assignment. Bare id (no relation), same
  // convention as Order.cancelledBy.
  assignedById     String?

  brief        ContentBrief?
  booking      PublisherBooking?
  trackedLinks TrackedLink[]

  @@index([assignedWriterId])
}

model ContentBrief {
  id          String   @id @default(cuid())
  orderLineId String   @unique
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  message     String?
  audience    String?
  references  String?
  doNotes     String?
  dontNotes   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets ContentAsset[]
}

model ContentAsset {
  id          String             @id @default(cuid())
  briefId     String
  brief       ContentBrief       @relation(fields: [briefId], references: [id])
  version     Int                @default(1)
  status      ContentAssetStatus @default(DRAFT)
  body        String?
  authorWriterId String?
  authorWriter   WriterProfile? @relation("AssetAuthor", fields: [authorWriterId], references: [id])
  bodyUrl     String? // pointer into object storage
  specPassed  Boolean?
  reviewNotes String?
  // Publisher-side editorial veto stamp. Separate from `reviewNotes`
  // because the audit chain needs to distinguish a soft "request
  // changes" comment from a hard "this will not run" decision.
  retractedAt     DateTime?
  retractedBy     String?
  retractionNote  String?
  // Lineage pointer for cross-market content reuse (Maja R2's gap).
  // When a writer adapts an existing article for a new market — e.g.
  // the Danish "Sådan slipper du HR-konsulenten" piece becomes the
  // Swedish version — this points at the source asset so:
  //   - the desk can charge adaptation-rate instead of greenfield
  //   - the audit chain shows where reused quotes originated
  //   - "asset library" listings group adaptations under their root
  sourceAssetId   String?
  sourceAsset     ContentAsset?  @relation("AssetLineage", fields: [sourceAssetId], references: [id])
  adaptations     ContentAsset[] @relation("AssetLineage")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([sourceAssetId])
  @@index([authorWriterId])
}

model PublisherBooking {
  id          String        @id @default(cuid())
  orderLineId String        @unique
  orderLine   OrderLine     @relation(fields: [orderLineId], references: [id])
  // Denormalized at booking creation (backfilled in migration via the
  // product chain) so the campaign report + MetricsRequest group by
  // publisher without a nullable Product join. Mirrors Title.countryCode.
  publisherId String?
  publisher   Publisher?    @relation(fields: [publisherId], references: [id])
  titleId     String?
  title       Title?        @relation(fields: [titleId], references: [id])
  status      BookingStatus @default(PENDING)
  placementDate DateTime?
  // Actual article run (may extend past Order.flightEndDate).
  liveStartDate DateTime?
  liveEndDate   DateTime?
  liveUrl     String?
  // Publisher's own tracking link, when they provide one.
  publisherTrackingUrl String?
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  metrics            BookingMetrics?
  metricsRequestRefs MetricsRequestBooking[]

  @@index([publisherId])
  @@index([titleId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  currency       String
  subtotal       Decimal       @db.Decimal(12, 2)
  vatPct         Decimal       @db.Decimal(5, 2)
  total          Decimal       @db.Decimal(12, 2)
  issuedAt       DateTime?
  dueAt          DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines       InvoiceLine[]
  creditNotes CreditNote[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
}

// Refund issued against an Invoice. Lives separately from the
// original invoice so the audit chain stays append-only: the invoice
// row records what was BILLED; the credit-note row records what was
// REFUNDED, with a stated reason. PLAN §13 / §14 (audit + per-market
// VAT) requires both halves of the story for any later tax filing.
//
// Closes the Kirsten R2 follow-on: once an order is CANCELLED *after*
// the invoice was issued, the only correct accounting move is a
// credit note — not silently voiding the invoice (which loses the
// "what was billed" record).
model CreditNote {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  currency   String
  amount     Decimal  @db.Decimal(12, 2)
  reason     String
  issuedAt   DateTime @default(now())
  issuedBy   String
  createdAt  DateTime @default(now())

  @@index([invoiceId])
  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // user id or "system"
  action    String // e.g. "price.update", "order.status_change"
  entity    String // e.g. "Product:abc123"
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

// Single-use magic-link sign-in token. Hashed at rest (SHA-256); the raw
// token only ever lives in the email URL. Mirrors the PublisherInvite
// pattern (single-use, time-limited).
model MagicLinkToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Single-use password-reset token. Same shape as MagicLinkToken — the two
// are kept as separate tables so we can prune / rate-limit / audit them
// independently and so a request for one doesn't shorten the window of
// the other.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SalesContact {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  role        String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  titles      SalesContactTitle[]
  requests    PriceRequest[]
  contactLogs ContactLog[]

  @@unique([publisherId, email])
  @@index([publisherId])
}

model SalesContactTitle {
  salesContactId String
  salesContact   SalesContact @relation(fields: [salesContactId], references: [id], onDelete: Cascade)
  titleId        String
  title          Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@id([salesContactId, titleId])
  @@index([titleId])
}

model PriceRequest {
  id              String   @id @default(cuid())
  titleId         String
  title           Title    @relation(fields: [titleId], references: [id])
  salesContactId  String
  salesContact    SalesContact @relation(fields: [salesContactId], references: [id])
  token           String   @unique
  expiresAt       DateTime
  sentAt          DateTime?
  openedAt        DateTime?
  respondedAt     DateTime?
  cancelledAt     DateTime?
  responseSource  PriceResponseSource?
  responseNote    String?
  hasNative       Boolean?
  requestedById   String
  requestedBy     User     @relation("PriceRequestRequester", fields: [requestedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([titleId])
  @@index([salesContactId])
  @@index([respondedAt])

  quotes PriceQuote[]
}

model PriceQuote {
  id               String   @id @default(cuid())
  priceRequestId   String?
  priceRequest     PriceRequest? @relation(fields: [priceRequestId], references: [id])

  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  draftProductType ProductType?
  draftProductName String?
  draftProductDesc String?

  price            Decimal  @db.Decimal(12, 2)
  // Semantics of `price`: a flat per-placement fee (FLAT), or a
  // per-click (CPC) / per-thousand-impressions (CPM) rate. Lets us
  // capture performance-priced offers without a separate column.
  priceUnit        PriceUnit @default(FLAT)
  currency         String
  includedText     String?
  excludedText     String?
  // Structured buyer-safe deliverables (same shape as Product.inclusions),
  // copied to the Product on apply.
  inclusions       Json?
  validUntil       DateTime?

  // Source media-kit / rate-card PDF this quote was extracted from, if
  // any. Nullable + ON DELETE SET NULL so applied prices survive a
  // document deletion.
  rateCardDocumentId String?
  rateCardDocument   RateCardDocument? @relation(fields: [rateCardDocumentId], references: [id], onDelete: SetNull)

  appliedAt        DateTime?
  appliedById      String?
  appliedBy        User?    @relation("PriceQuoteApplier", fields: [appliedById], references: [id])
  rejectedAt       DateTime?
  rejectedById     String?
  rejectedReason   String?

  recordedAt       DateTime @default(now())
  recordedById     String
  contactLogId     String?
  contactLog       ContactLog? @relation(fields: [contactLogId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([priceRequestId])
  @@index([appliedAt])
  @@index([contactLogId])
  @@index([rateCardDocumentId])
}

// Semantics for PriceQuote.price — flat per-placement fee, or a
// performance rate (per click / per mille impressions).
enum PriceUnit {
  FLAT
  CPC
  CPM
}

// Whether a publication will run the advertiser's own (delivered)
// editorial/article content, as opposed to publisher-produced native.
enum OwnContent {
  YES
  NO
  WITH_APPROVAL
  UNKNOWN
}

// Whether a title has been positively confirmed as still in production.
// UNVERIFIED is the default — a title is not trusted until checked against its
// own site / a reliable source. LIVE = confirmed currently published.
// DISCONTINUED = confirmed closed/merged/renamed (pairs with discontinuedAt).
// UNCERTAIN = checked but could not be confirmed either way.
enum VerificationStatus {
  UNVERIFIED
  LIVE
  DISCONTINUED
  UNCERTAIN
}

// Raw storage + history for every received rate-card / media-kit PDF.
// The original file lives in R2 (objectKey); ocrText holds the full
// extracted text (digital + image OCR) so prices stored as images are
// still searchable. Extracted images are never stored.
model RateCardDocument {
  id           String      @id @default(cuid())
  titleId      String?
  title        Title?      @relation(fields: [titleId], references: [id], onDelete: SetNull)
  publisherId  String?
  publisher    Publisher?  @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  contactLogId String?
  contactLog   ContactLog? @relation(fields: [contactLogId], references: [id], onDelete: SetNull)
  fileName     String
  objectKey    String // R2 key
  contentType  String      @default("application/pdf")
  sizeBytes    Int?
  ocrText      String? // full extracted text (digital + image OCR)
  ocrStatus    String      @default("PENDING") // PENDING | DONE | FAILED
  source       String? // e.g. "email:andreas@admirate.no"
  receivedAt   DateTime    @default(now())
  createdById  String
  createdAt    DateTime    @default(now())

  quotes PriceQuote[]

  @@index([titleId])
  @@index([publisherId])
  @@index([contactLogId])
}

enum ContactChannel {
  EMAIL
  PHONE
  WEB_FORM
  LINKEDIN
  OTHER
}

enum ContactDirection {
  OUTBOUND
  INBOUND
}

model ContactLog {
  id             String           @id @default(cuid())
  titleId        String
  title          Title            @relation(fields: [titleId], references: [id])
  salesContactId String?
  salesContact   SalesContact?    @relation(fields: [salesContactId], references: [id], onDelete: SetNull)
  channel        ContactChannel
  direction      ContactDirection @default(OUTBOUND)
  contactedAt    DateTime         @default(now())
  contactedById  String
  contactedBy    User             @relation("ContactLogAuthor", fields: [contactedById], references: [id])
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  quotes            PriceQuote[]
  rateCardDocuments RateCardDocument[]

  @@index([titleId])
  @@index([contactedAt])
  @@index([salesContactId])
}

// One row = one recipient = one campaign thread = one token.
// Spans potentially many titles across many publishers (sales-house case).
model RateCardRequest {
  id                String                  @id @default(cuid())
  recipientEmail    String
  recipientName     String?
  locale            String
  token             String                  @unique
  sentCount         Int                     @default(0)
  lastStepAt        DateTime?
  nextStepAt        DateTime?
  sentAt            DateTime?
  openedAt          DateTime?
  respondedAt       DateTime?
  cancelledAt       DateTime?
  expiresAt         DateTime
  mediaKitUrl       String?
  mediaKitObjectKey String?
  responseNote      String?
  formatsOffered    String[]
  contactName       String?
  contactEmail      String?
  contactRole       String?
  responseData      Json?
  responseSource    RateCardResponseSource?
  createdById       String
  createdBy         User                    @relation("RateCardRequestCreator", fields: [createdById], references: [id])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  titles            RateCardRequestTitle[]

  @@index([recipientEmail])
  @@index([nextStepAt, respondedAt, cancelledAt])
  @@index([respondedAt])
}

enum RateCardResponseSource {
  FORM
  EMAIL
}

model RateCardRequestTitle {
  rateCardRequestId String
  rateCardRequest   RateCardRequest @relation(fields: [rateCardRequestId], references: [id], onDelete: Cascade)
  titleId           String
  title             Title           @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([rateCardRequestId, titleId])
  @@index([titleId])
}

// One row = one (order, publisher) = one campaign-report thread = one token.
// Collects end-of-campaign numbers for that publisher's bookings in the order.
model MetricsRequest {
  id             String               @id @default(cuid())
  orderId        String
  order          Order                @relation(fields: [orderId], references: [id])
  publisherId    String
  publisher      Publisher            @relation(fields: [publisherId], references: [id])
  recipientEmail String?              // frozen at creation; null while NEEDS_CONTACT
  recipientName  String?
  locale         String               @default("en")
  token          String               @unique
  status         MetricsRequestStatus @default(PENDING)
  sentCount      Int                  @default(0)
  lastStepAt     DateTime?
  nextStepAt     DateTime?
  sentAt         DateTime?
  openedAt       DateTime?
  respondedAt    DateTime?
  cancelledAt    DateTime?
  expiresAt      DateTime
  createdById    String
  createdBy      User                 @relation("MetricsRequestCreator", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  bookings MetricsRequestBooking[]

  @@unique([orderId, publisherId])
  @@index([orderId])
  @@index([nextStepAt, respondedAt, cancelledAt])
  @@index([status])
}

model MetricsRequestBooking {
  metricsRequestId String
  metricsRequest   MetricsRequest   @relation(fields: [metricsRequestId], references: [id], onDelete: Cascade)
  bookingId        String
  booking          PublisherBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([metricsRequestId, bookingId])
  @@index([bookingId])
}

// Email suppression list — recipients who unsubscribed, bounced, or were manually excluded.
model OutreachSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())
}

// First-party tracked link embedded in a produced article. NativeSpin
// writes the content, so it owns the outbound links — each becomes a
// /go/<token> that counts clicks before redirecting to the advertiser.
model TrackedLink {
  id          String    @id @default(cuid())
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  token       String    @unique
  targetUrl   String
  label       String?
  clickCount  Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([orderLineId])
}

// Optional publisher/desk-reported reach for a live booking. Clicks come
// from TrackedLink (first-party); impressions are the one number only the
// publisher can supply, so they stay optional.
model BookingMetrics {
  id          String           @id @default(cuid())
  bookingId   String           @unique
  booking     PublisherBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Latest reported values ("live-to-date").
  impressions Int?
  pageViews   Int?
  publisherReportedClicks Int? // publisher's own click count; distinct from first-party TrackedLink clicks
  avgTimeSec  Int?
  scrollDepthPct Int?
  extra       Json?            // only not-yet-promoted extras; never anything the report renders
  windowStart DateTime?
  windowEnd   DateTime?
  // Frozen campaign snapshot (the advertiser deliverable). Set at close; immutable after.
  frozenAt    DateTime?
  impressionsAtClose      Int?
  clicksFirstPartyAtClose Int?
  source      MetricsSource    @default(PUBLISHER_FORM)
  note        String?          // for the email path: the raw quoted snippet the number came from
  reportedAt  DateTime?
  reportedBy  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

// Marketing newsletter subscriber. Double opt-in: a row is PENDING until
// the recipient clicks the tokenised confirm link, then CONFIRMED. The
// raw tokens live only in email URLs; we store SHA-256 hashes (same
// pattern as MagicLinkToken). The unsub token is long-lived so links in
// old emails keep working; the confirm token is single-use + expires.
model Subscriber {
  email            String           @id
  locale           String
  status           SubscriberStatus @default(PENDING)
  source           String // where the signup came from: "footer", "home", ...
  confirmTokenHash String?          @unique
  confirmExpiresAt DateTime?
  unsubTokenHash   String           @unique
  createdAt        DateTime         @default(now())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?

  @@index([status])
}

// ---------- Writer Pool ----------

// Freelance writer profile. 1:1 with a User whose role is CONTENT. Carries
// the matching signals the desk uses to staff an order: languages,
// specialties, rate, and capacity.
model WriterProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                  String?
  ratePerArticle       Decimal? @db.Decimal(12, 2)
  ratePerWord          Decimal? @db.Decimal(12, 4)
  currency             String? // ISO 4217; default from home market
  maxActiveAssignments Int? // capacity guidance; over-cap warns, never blocks
  active               Boolean  @default(true) // left / on pause
  portfolioUrl         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  languages       WriterLanguage[]
  specialties     WriterSpecialty[]
  poolMemberships OrderWriterPool[]
  assignedLines   OrderLine[]       @relation("LineAssignedWriter")
  authoredAssets  ContentAsset[]    @relation("AssetAuthor")
}

model WriterLanguage {
  id          String              @id @default(cuid())
  writerId    String
  writer      WriterProfile       @relation(fields: [writerId], references: [id], onDelete: Cascade)
  language    ContentLanguage
  proficiency LanguageProficiency @default(FLUENT)

  @@unique([writerId, language])
}

model WriterSpecialty {
  id       String        @id @default(cuid())
  writerId String
  writer   WriterProfile @relation(fields: [writerId], references: [id], onDelete: Cascade)
  topic    ContentTopic

  @@unique([writerId, topic])
}

// Candidate writers attached to an order. The desk builds this pool;
// per-line assignment (OrderLine.assignedWriter) must be a pool member.
model OrderWriterPool {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  writerId  String
  writer    WriterProfile @relation(fields: [writerId], references: [id])
  addedById String // desk user who added them
  addedAt   DateTime      @default(now())

  @@unique([orderId, writerId])
  @@index([writerId])
}

// Single-use, time-limited invite that binds a new User{role: CONTENT}
// and an empty WriterProfile on claim. Mirrors PublisherInvite.
model WriterInvite {
  id              String    @id @default(cuid())
  email           String
  token           String    @unique
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?
  createdBy       String
  createdAt       DateTime  @default(now())

  @@index([email])
}

// Favorites: a buyer's personal shortlist of publications (titles). Kept
// entirely separate from the org-scoped SavedList/RFQ model — titles-only,
// per-user, no money or quote semantics. A FavoriteList can be opt-in shared
// with the owner's org (read-only for teammates).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  listItems FavoriteListItem[]

  @@unique([userId, titleId])
  @@index([userId, createdAt])
}

model FavoriteList {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String        @default("Untitled list")
  sharedWithOrg  Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items FavoriteListItem[]

  @@index([userId])
  @@index([organizationId, sharedWithOrg])
}

// Membership references a Favorite (not a Title) so a list is always a subset
// of the owner's hearted pool; un-hearting cascades it out of every list.
model FavoriteListItem {
  id         String       @id @default(cuid())
  listId     String
  list       FavoriteList @relation(fields: [listId], references: [id], onDelete: Cascade)
  favoriteId String
  favorite   Favorite     @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@unique([listId, favoriteId])
  @@index([listId, sortOrder])
  // favoriteId-led lookups: getListMembershipForTitles (runs every catalog
  // render) and the active-item _count subqueries join on favoriteId.
  @@index([favoriteId])
}
