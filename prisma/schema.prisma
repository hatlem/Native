// BeNative data model — see PLAN.md §8.
// Phase 0 focuses on the catalog (Market/Publisher/Title/Product/PriceRule/Spec);
// the commerce/content entities are modeled now because they gate later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum MarketCode {
  NO
  SE
  DK
}

enum ProductType {
  NATIVE_ARTICLE
  ADVERTORIAL
  NATIVE_DISPLAY
  PACKAGE
}

enum PricingModel {
  FLAT
  CPM
  CPC
  PACKAGE
}

enum PriceVisibility {
  INDICATIVE
  FIRM
}

enum OrgType {
  ADVERTISER
  AGENCY
}

enum UserRole {
  BUYER
  APPROVER
  ORG_ADMIN
  DESK
  CONTENT
  PUBLISHER
  SUPERADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  QUOTED
  CLOSED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  DECLINED
}

enum OrderStatus {
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  SCHEDULED
  LIVE
  COMPLETED
  INVOICED
  CANCELLED
}

enum ContentAssetStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  FINAL
}

enum BookingStatus {
  PENDING
  BOOKED
  PUBLISHED
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

// ---------- Catalog ----------

model Market {
  id           String     @id @default(cuid())
  code         MarketCode @unique
  name         String
  currency     String // ISO 4217, e.g. NOK / SEK / DKK
  defaultLocale String    @default("en")
  vatRatePct   Decimal    @db.Decimal(5, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  publishers Publisher[]
  titles     Title[]
}

model Publisher {
  id            String   @id @default(cuid())
  name          String
  marketId      String
  market        Market   @relation(fields: [marketId], references: [id])
  contactEmail  String?
  paymentTerms  String? // e.g. "net 30"
  contractNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  titles Title[]

  @@unique([marketId, name])
}

model Title {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  publisherId   String
  publisher     Publisher @relation(fields: [publisherId], references: [id])
  marketId      String
  market        Market    @relation(fields: [marketId], references: [id])
  category      String // e.g. "general-news", "business", "lifestyle"
  audienceNote  String?
  monthlyReach  Int? // estimated readers / month
  websiteUrl    String?
  active        Boolean   @default(true)
  lastVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products Product[]
}

model Product {
  id           String          @id @default(cuid())
  titleId      String
  title        Title           @relation(fields: [titleId], references: [id])
  type         ProductType
  name         String
  description  String?
  pricingModel PricingModel    @default(FLAT)
  basePrice    Decimal         @db.Decimal(12, 2)
  currency     String // ISO 4217, normally inherited from Market
  visibility   PriceVisibility @default(INDICATIVE)
  leadTimeDays Int             @default(10)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  priceRules PriceRule[]
  spec       Spec?
}

model PriceRule {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  label              String   @default("default")
  marginPct          Decimal  @default(15) @db.Decimal(5, 2)
  seasonalMultiplier Decimal  @default(1) @db.Decimal(5, 2)
  minVolume          Int      @default(1)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Spec {
  id           String   @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
  wordCountMin Int?
  wordCountMax Int?
  imagesMin    Int?     @default(1)
  disclosureLabel String? // required sponsored/native marking text
  fileFormats  String? // e.g. "JPG, PNG"
  requirements String? // free-form additional requirements
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Accounts ----------

model Organization {
  id            String   @id @default(cuid())
  name          String
  type          OrgType
  marketCode    MarketCode
  vatId         String?
  parentOrgId   String?
  parentOrg     Organization?  @relation("AgencyClients", fields: [parentOrgId], references: [id])
  clients       Organization[] @relation("AgencyClients")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users    User[]
  plans    Plan[]
  requests Request[]
  orders   Order[]
  invoices Invoice[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  role           UserRole     @default(BUYER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------- Plan -> Request -> Quote -> Order ----------

model Plan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String       @default("Untitled plan")
  budget         Decimal?     @db.Decimal(12, 2)
  currency       String?
  startDate      DateTime?
  endDate        DateTime?
  audienceNote   String?
  goal           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items   PlanItem[]
  request Request?
}

model PlanItem {
  id        String  @id @default(cuid())
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id])
  productId String
  quantity  Int     @default(1)
  notes     String?
}

model Request {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  planId         String        @unique
  plan           Plan          @relation(fields: [planId], references: [id])
  status         RequestStatus @default(DRAFT)
  briefSummary   String?
  assignedDeskUserId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quotes Quote[]
}

model Quote {
  id          String      @id @default(cuid())
  requestId   String
  request     Request     @relation(fields: [requestId], references: [id])
  status      QuoteStatus @default(DRAFT)
  currency    String
  subtotal    Decimal     @db.Decimal(12, 2)
  vatPct      Decimal     @db.Decimal(5, 2)
  total       Decimal     @db.Decimal(12, 2)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines QuoteLine[]
  order Order?
}

model QuoteLine {
  id            String  @id @default(cuid())
  quoteId       String
  quote         Quote   @relation(fields: [quoteId], references: [id])
  productId     String
  description   String
  quantity      Int     @default(1)
  unitCost      Decimal @db.Decimal(12, 2)
  marginPct     Decimal @db.Decimal(5, 2)
  lineTotal     Decimal @db.Decimal(12, 2)
  availability  String?
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  quoteId        String       @unique
  quote          Quote        @relation(fields: [quoteId], references: [id])
  status         OrderStatus  @default(QUOTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines    OrderLine[]
  invoices Invoice[]
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  quantity  Int     @default(1)
  lineTotal Decimal @db.Decimal(12, 2)

  brief   ContentBrief?
  booking PublisherBooking?
}

model ContentBrief {
  id          String   @id @default(cuid())
  orderLineId String   @unique
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  message     String?
  audience    String?
  references  String?
  doNotes     String?
  dontNotes   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets ContentAsset[]
}

model ContentAsset {
  id          String             @id @default(cuid())
  briefId     String
  brief       ContentBrief       @relation(fields: [briefId], references: [id])
  version     Int                @default(1)
  status      ContentAssetStatus @default(DRAFT)
  bodyUrl     String? // pointer into object storage
  specPassed  Boolean?
  reviewNotes String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PublisherBooking {
  id          String        @id @default(cuid())
  orderLineId String        @unique
  orderLine   OrderLine     @relation(fields: [orderLineId], references: [id])
  status      BookingStatus @default(PENDING)
  placementDate DateTime?
  liveUrl     String?
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  currency       String
  subtotal       Decimal       @db.Decimal(12, 2)
  vatPct         Decimal       @db.Decimal(5, 2)
  total          Decimal       @db.Decimal(12, 2)
  issuedAt       DateTime?
  dueAt          DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines InvoiceLine[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // user id or "system"
  action    String // e.g. "price.update", "order.status_change"
  entity    String // e.g. "Product:abc123"
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}
